{
  "project": "ALYMP",
  "repo": "nikalimp/ALYMP",
  "site_dir": ".",
  "targets": {
    "test": {
      "url": "https://alymp.nikalimp.ru",
      "ftp_dir_secret": "FTP_DIR",
      "indexable": false
    },
    "prod": {
      "url": "https://alymp.ru",
      "ftp_dir_secret": "FTP_DIR_PROD",
      "indexable": true
    }
  },
  "url": "https://alymp.nikalimp.ru",
  "adapter": "ssh-ftp",
  "mode": "auto",
  "content_dir": "content",
  "factory": "content/factory/content.config.json",
  "schedule": {
    "daily": "09:05",
    "weekly": "mon 08:50",
    "tz": "Europe/Moscow",
    "days": "1-5"
  },
  "version": 2,
  "notes": "Тест alymp.nikalimp.ru (закрыт от поисковиков) и прод alymp.ru (открыт сразу после сборки — решение Ника 25.11.2026). Заявки и config.php формы живут только на сервере.",
  "out_dir": "out",
  "app_path": "",
  "rsync_exclude": "api/config.php api/leads/",
  "manual_script": "scripts/deploy-site.sh"
}